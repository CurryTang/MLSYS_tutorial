			"seed": 125,
			"version": 4,
			"versionNonce": 1186769658,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1788980422737,
			"link": null,
			"locked": false,
			"type": "text",
			"id": "t29",
			"x": 40,
			"y": 900,
			"text": "A. Rate limit + synchronous DB\n   + simple; immediate result\n   - overload rejected; no burst buffer\n\nB. Rate limit + Kafka + Worker [chosen]\n   + smooth bursts; retry transient errors\n   - queue delay; extra infrastructure\n   Change: insert MQ + Worker before DB",
			"fontSize": 20,
			"fontFamily": 1,
			"width": 367.01171875,
			"height": 200,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A. Rate limit + synchronous DB\n   + simple; immediate result\n   - overload rejected; no burst buffer\n\nB. Rate limit + Kafka + Worker [chosen]\n   + smooth bursts; retry transient errors\n   - queue delay; extra infrastructure\n   Change: insert MQ + Worker before DB",
			"autoResize": true,
			"lineHeight": 1.25,
			"index": "b0m",
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null
		},
