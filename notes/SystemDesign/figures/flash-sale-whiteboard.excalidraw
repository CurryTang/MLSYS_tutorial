			"isDeleted": false,
			"boundElements": [],
			"updated": 1788980422737,
			"link": null,
			"locked": false,
			"type": "text",
			"id": "t31",
			"x": 560,
			"y": 900,
			"text": "A. Pessimistic lock [chosen]\n   + lock sale row; check stock; create order\n   - hot sale causes lock waiting\n\nB. Optimistic lock (version / CAS)\n   + no up-front lock; detect conflicts\n   - many retries under heavy contention\n   Both: one DB transaction + unique user",
			"fontSize": 20,
			"fontFamily": 1,
			"width": 384.04296875,
			"height": 200,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "A. Pessimistic lock [chosen]\n   + lock sale row; check stock; create order\n   - hot sale causes lock waiting\n\nB. Optimistic lock (version / CAS)\n   + no up-front lock; detect conflicts\n   - many retries under heavy contention\n   Both: one DB transaction + unique user",
			"autoResize": true,
			"lineHeight": 1.25,
			"index": "b0o",
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null
		},
		{
			"angle": 0,
