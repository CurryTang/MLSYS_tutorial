			"x": 40,
			"y": 855,
			"text": "1. Burst load → Availability / Scale",
			"fontSize": 24,
			"fontFamily": 1,
			"width": 365.07421875,
			"height": 30,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. Burst load → Availability / Scale",
			"autoResize": true,
			"lineHeight": 1.25,
			"index": "b0l",
			"hasTextLink": false,
			"rawText": "",
			"labelPosition": null
		},
		{
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1.4,
			"opacity": 100,
			"groupIds": [
				"7tTRQ9zeJ8S8W-RMnRqDV"
			],
			"frameId": null,
