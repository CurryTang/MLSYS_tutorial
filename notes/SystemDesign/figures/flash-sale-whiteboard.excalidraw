			"x": 560,
			"y": 855,
			"text": "2. Data race → Consistency",
			"fontSize": 24,
			"fontFamily": 1,
			"width": 298.79296875,
			"height": 30,
			"textAlign": "left",
			"verticalAlign": "top",
