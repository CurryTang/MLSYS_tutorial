			"type": "text",
			"id": "t27",
			"x": 1040,
			"y": 731,
			"text": "1M users / 10s × 2 attempts = 200k/s\nWorker budget: e.g. 2k attempts/s; load test.\nBound queue + reject excess; MQ adds no DB capacity.",
			"fontSize": 18,
			"fontFamily": 1,
			"width": 445.4208984375,
			"height": 67.5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1M users / 10s × 2 attempts = 200k/s\nWorker budget: e.g. 2k attempts/s; load test.\nBound queue + reject excess; MQ adds no DB capacity.",
