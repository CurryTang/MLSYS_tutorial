			"x": 1040,
			"y": 590,
			"text": "One sale = one item / SKU.\nUNIQUE(sale_id, user_id) on order.\nStock update + order insert: ONE transaction.",
			"fontSize": 20,
			"fontFamily": 1,
			"width": 404.091796875,
